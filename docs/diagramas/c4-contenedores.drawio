        </mxCell>
        <mxCell id="text-19" value="Todas las cajas claras son propuestas. En E1 solo existen los dos procesos mínimos de /src/, sin base de negocio." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=20;fontColor=#102b46;" vertex="1" parent="1">
          <mxGeometry x="45" y="1041" width="1349.3999999999999" height="33" as="geometry" />
        </mxCell>
        <mxCell id="text-20" value="I10–I12: propagación diferida en segundo plano; cada consulta HTTP es sincrónica. Cursor durable y deduplicación." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=20;fontColor=#102b46;" vertex="1" parent="1">
          <mxGeometry x="45" y="1068" width="1349.3999999999999" height="33" as="geometry" />
        </mxCell>
        <mxCell id="text-21" value="Las flechas indican quién inicia la interacción; las respuestas recorren la misma conexión. No representan un broker." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=20;fontColor=#102b46;" vertex="1" parent="1">
          <mxGeometry x="45" y="1095" width="1396.6" height="33" as="geometry" />
        </mxCell>
        <mxCell id="text-22" value="Cada almacén es privado. SGA excluido: no hay integración activa. TLS y autorización entre servicios pendientes de implementar." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=20;fontColor=#102b46;" vertex="1" parent="1">
          <mxGeometry x="45" y="1123" width="1514.6" height="33" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>